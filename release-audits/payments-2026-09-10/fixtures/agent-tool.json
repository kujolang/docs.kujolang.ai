{
  "type": "function",
  "function": {
    "name": "payment",
    "description": "Request or track an authorized purchase without payment credentials.",
    "parameters": {
      "type": "object",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "action": {
              "const": "request"
            },
            "purchase": {
              "type": "object",
              "properties": {
                "purchase_ref": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "payee_ref": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "amount": {
                  "type": "object",
                  "properties": {
                    "mode": {
                      "enum": [
                        "exact",
                        "maximum"
                      ]
                    },
                    "minor": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 9007199254740991
                    },
                    "currency": {
                      "type": "string",
                      "pattern": "^[A-Z]{3}$"
                    }
                  },
                  "required": [
                    "mode",
                    "minor",
                    "currency"
                  ],
                  "additionalProperties": false
                },
                "purpose": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 500
                },
                "payment_profile": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "shipping_profile": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "provider_preference": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64
                },
                "expires_in_ms": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 600000
                }
              },
              "required": [
                "purchase_ref",
                "payee_ref",
                "amount",
                "purpose",
                "payment_profile",
                "expires_in_ms"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "action",
            "purchase"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "action": {
              "const": "status"
            },
            "execution_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          },
          "required": [
            "action",
            "execution_id"
          ],
          "additionalProperties": false
        }
      ]
    }
  }
}
