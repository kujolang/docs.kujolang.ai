func clean_slug(text) {
	slug := to_lower(trim(text))
	slug := regex_replace(slug, "[^a-z0-9]+", "-")
	slug := regex_replace(slug, "^-+|-+$", "")
	if len(slug) == 0 {
		return "untitled"
	}
	return slug
}

func html_escape(value) {
	return escape_xml(value)
}

func fenced_code_paragraph_text(line) {
	clean := trim(line)
	if starts_with(clean, "<p>") && ends_with(clean, "</p>") && len(clean) >= 7 {
		return substring(clean, 3, len(clean) - 4)
	}
	return line
}

func fenced_code_block_html(language, code_lines) {
	class_attr := ""
	language_slug := clean_slug(language)
	if len(language_slug) > 0 && language_slug != "untitled" {
		class_attr = " class=\"language-" + html_escape(language_slug) + "\""
	}
	return "<pre><code" + class_attr + ">" + join(code_lines, "\n") + "</code></pre>"
}

func normalize_fenced_code_html(html) {
	if index_of(html, "```") < 0 {
		return html
	}

	lines := split(html, "\n")
	out := []
	code_lines := []
	in_code := false
	code_language := ""
	i := 0
	loop {
		if i >= len(lines) {
			break
		}

		line := lines[i]
		i := i + 1
		paragraph_text := trim(fenced_code_paragraph_text(line))
		if starts_with(paragraph_text, "```") {
			if in_code {
				out = push(out, fenced_code_block_html(code_language, code_lines))
				code_lines := []
				code_language := ""
				in_code := false
			} else {
				code_language = trim(substring(paragraph_text, 3, len(paragraph_text)))
				code_lines := []
				in_code := true
			}
			continue
		}

		if in_code {
			code_lines = push(code_lines, fenced_code_paragraph_text(line))
		} else {
			out = push(out, line)
		}
	}

	if in_code {
		out = push(out, fenced_code_block_html(code_language, code_lines))
	}

	return join(out, "\n")
}

func markdown_to_html(markdown) {
	return normalize_fenced_code_html(render_markdown(markdown))
}

print(markdown_to_html("```bash\n# Inspect release availability\nkujo upgrade --check\n```"))
